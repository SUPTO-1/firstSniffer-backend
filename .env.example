# Server
PORT=5000
NODE_ENV=development

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# MongoDB (matches docker/docker-compose.yml credentials)
MONGODB_URI=mongodb://admin:password@localhost:27017/firstsniffer?authSource=admin

# JWT
JWT_SECRET=replace-this-with-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_NAME=fs_token
COOKIE_SECURE=false

# Admin (auto-seeded on first boot if no user with ADMIN_EMAIL exists)
ADMIN_NAME=
ADMIN_NICKNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Email (Resend) — the only email provider.
#
# These are the SAME variable names the backend already reads. The
# service degrades gracefully when they are missing: emails are simply
# not sent and every business flow (order creation, registration)
# continues to work. Nothing here is ever logged.
#
# RESEND_API_KEY  → from https://resend.com/api-keys
# EMAIL_FROM      → a verified sender on your Resend account, e.g.
#                   "First Sniffer <orders@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=
